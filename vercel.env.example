# Add these in Vercel > Project > Settings > Environment Variables.
# Do not rename variables. Do not commit real values.

# Browser-visible Supabase configuration
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=PASTE_PUBLISHABLE_OR_ANON_KEY

# Same-origin Vercel functions. Set this to an EMPTY value in Vercel.
VITE_AI_BACKEND_URL=

# Server-only Supabase configuration
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=PASTE_SERVICE_ROLE_KEY

# Server-only AI provider. Set exactly one provider key.
GEMINI_API_KEY=PASTE_GEMINI_KEY
# GROQ_API_KEY=PASTE_GROQ_KEY
# OPENAI_API_KEY=PASTE_OPENAI_KEY

# Optional: Ticketmaster Discovery API key for verified live events.
# TICKETMASTER_API_KEY=PASTE_TICKETMASTER_KEY

# Optional: official Google Places API key for additional place candidates.
# Results are server-side only and are still model-curated and geocoded before display.
# GOOGLE_PLACES_API_KEY=PASTE_GOOGLE_PLACES_KEY

# Optional: comma-separated official public exhibition/event pages with JSON-LD Event markup.
# PUBLIC_EVENT_SOURCES=https://example-museum.org/exhibitions,https://example-gallery.org/whats-on

# Exact deployed origin, without a trailing slash.
ALLOWED_ORIGIN=https://YOUR_VERCEL_DOMAIN

# Optional provider overrides
# AI_PROVIDER=gemini
# AI_MODEL=gemini-flash-lite-latest