# ---------------------------------------------------------------------------
# Sidequest frontend environment (safe to expose to the browser).
# Copy this file to `.env` and fill in your own values.
# NEVER put secret keys (OpenAI, Supabase service role) in this file.
# ---------------------------------------------------------------------------

# Supabase project (Project Settings -> API).
VITE_SUPABASE_URL= 
VITE_SUPABASE_ANON_KEY=

# Sidequest API base URL.
#   Local dev  -> http://localhost:8787  (run `npm run server`)
#   Production -> leave empty or "/api"  (Vercel serverless functions)
VITE_AI_BACKEND_URL=http://localhost:8787
