# ---------------------------------------------------------------------------
# Sidequest backend / serverless environment (SERVER-SIDE ONLY, secret).
# Copy this file to `server/.env` and fill in your own values.
# These variables are also set in the Vercel dashboard for production.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# AI provider. Set exactly ONE key below to enable real-time AI plans.
# The server auto-detects which provider you configured. All are OpenAI-compatible.
#
#   * Google Gemini  -> FREE, no billing. Key: https://aistudio.google.com/apikey
#   * Groq           -> FREE, no billing. Key: https://console.groq.com/keys
#   * OpenAI         -> paid.             Key: https://platform.openai.com/api-keys
#
# Pick one (Gemini or Groq are free and recommended):
GEMINI_API_KEY=
# GROQ_API_KEY=
# OPENAI_API_KEY=

# Optional: documented Ticketmaster Discovery API key for real event discovery.
# Free default quota is 5,000 calls/day. BookMyShow and District do not offer
# a supported public discovery API, so do not add scraped credentials here.
# TICKETMASTER_API_KEY=

# Optional: comma-separated HTTPS pages from official museums, galleries or
# venues. Sidequest only reads public JSON-LD Event markup from this allowlist,
# checks robots.txt first, and never crawls listing/ticketing platforms.
# PUBLIC_EVENT_SOURCES=https://example-museum.org/exhibitions,https://example-gallery.org/whats-on

# Optional overrides (sensible defaults are used per provider):
# AI_PROVIDER=gemini            # force a provider: gemini | groq | openai
# AI_MODEL=gemini-flash-latest  # override the model
# AI_BASE_URL=                  # override the OpenAI-compatible base URL

# Supabase (service role key -> lets the API write ai_generations logs).
# Project Settings -> API -> service_role secret. NEVER expose to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: port for the local dev server (default 8787).
# PORT=8787
# Optional: comma-separated browser origins allowed to call this server.
# ALLOWED_ORIGIN=http://localhost:5173,http://localhost:4173
# Production example:
# ALLOWED_ORIGIN=https://sidequest.example.com
